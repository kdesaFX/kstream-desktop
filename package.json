{
  "name": "kstream-desktop",
  "productName": "kstream",
  "version": "1.2.31",
  "description": "kstream: stream movies and shows on Windows",
  "author": "kstream",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --config electron-builder.config.cjs --win",
    "build:win": "electron-builder --config electron-builder.config.cjs --win",
    "dist": "electron-builder --config electron-builder.config.cjs --win --publish=never",
    "dist:signed": "electron-builder --config electron-builder.config.cjs --win --publish=never"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.7.3"
  },
  "devDependencies": {
    "electron": "^39.3.0",
    "electron-builder": "^26.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller"
    ]
  }
}
